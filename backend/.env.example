# SQL Server Express (Windows Auth / Trusted Connection)
SQL_SERVER_INSTANCE=OMIKRON\SQLEXPRESS
SQL_DATABASE=RancoDocExtract
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Azure OpenAI (Foundry) - API surface v1 (Responses API), sin api-version.
# AZURE_OPENAI_ENDPOINT: URL completa que entrega Foundry, ej.
# https://<recurso>.services.ai.azure.com/api/projects/<proyecto>/openai/v1/responses
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Pipeline
CONFIDENCE_THRESHOLD=0.8
